rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidHexColor(hex) {
      return hex is string && hex.matches('^#[0-9A-Fa-f]{6}$');
    }

    // Entity Validation Helpers
    function isValidFolder(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             isValidHexColor(data.colorHex) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDocument(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160 &&
             data.category in ['merged', 'converted', 'signed', 'imported'] &&
             data.favorite is bool &&
             data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 50000 &&
             data.fileSizeBytes is int && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 500000000 &&
             data.localPath is string && data.localPath.size() <= 400 &&
             (!('folderId' in data) || isValidId(data.folderId)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             (!('lastOpenedAt' in data) || (data.lastOpenedAt is timestamp && data.lastOpenedAt <= request.time));
    }

    function isValidSignature(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             isValidHexColor(data.inkColorHex) &&
             data.imageBase64 is string && data.imageBase64.size() >= 10 && data.imageBase64.size() <= 300000 &&
             (data.aspectRatio is float || data.aspectRatio is int) && data.aspectRatio > 0 && data.aspectRatio <= 20 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      // User-owned Folders
      match /folders/{folderId} {
        allow get: if isOwner(userId) && isValidId(folderId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(folderId) &&
                         incoming().keys().hasAll(['userId', 'name', 'colorHex', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'colorHex', 'createdAt', 'updatedAt']) &&
                         isValidFolder(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(folderId) &&
                         isValidFolder(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'colorHex', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(folderId);
      }

      // User-owned PDF Document Metadata
      match /documents/{documentId} {
        allow get: if isOwner(userId) && isValidId(documentId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(documentId) &&
                         incoming().keys().hasAll(['userId', 'title', 'fileName', 'category', 'favorite', 'pageCount', 'fileSizeBytes', 'localPath', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'fileName', 'folderId', 'category', 'favorite', 'pageCount', 'fileSizeBytes', 'localPath', 'createdAt', 'updatedAt', 'lastOpenedAt']) &&
                         isValidDocument(incoming(), userId) &&
                         (!('folderId' in incoming()) || exists(/databases/$(database)/documents/users/$(userId)/folders/$(incoming().folderId)));
        allow update: if isOwner(userId) &&
                         isValidId(documentId) &&
                         isValidDocument(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['favorite', 'updatedAt']) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['folderId', 'updatedAt']) &&
                             (!('folderId' in incoming()) || exists(/databases/$(database)/documents/users/$(userId)/folders/$(incoming().folderId)))) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['lastOpenedAt', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['localPath', 'pageCount', 'fileSizeBytes', 'updatedAt'])
                         );
        allow delete: if isOwner(userId) && isValidId(documentId);
      }

      // User-owned Saved Signatures
      match /signatures/{signatureId} {
        allow get: if isOwner(userId) && isValidId(signatureId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(signatureId) &&
                         incoming().keys().hasAll(['userId', 'name', 'inkColorHex', 'imageBase64', 'aspectRatio', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'inkColorHex', 'imageBase64', 'aspectRatio', 'createdAt', 'updatedAt']) &&
                         isValidSignature(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(signatureId) &&
                         isValidSignature(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(signatureId);
      }
    }
  }
}
